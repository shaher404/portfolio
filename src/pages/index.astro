---
import Layout from '../layouts/Layout.astro';

const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Experience', href: '#experience' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];

const experiences = [
  {
    role: "Deputy Manager, Business Development",
    company: "Z3 Corporation",
    period: "2024 — Present",
    current: true,
    description: "Spearheading strategic enterprise growth and B2B client acquisition across industrial sectors and export processing zones. Bridging operational consulting with high-impact stakeholder negotiations.",
    highlights: [
      "Targeted enterprise pipeline structuring & executive-level B2B closures",
      "Strategic market penetration and multi-party stakeholder alignment",
      "Cross-functional collaboration aligning operations with corporate expansion"
    ]
  },
  {
    role: "Product Designer & Media Planner",
    company: "MRZ Group",
    period: "2020 — 2024",
    current: false,
    description: "Owned the end-to-end design lifecycle for high-traffic mobile and web applications, scaling platform engagement and standardizing UI/UX infrastructure.",
    highlights: [
      "Sole designer for multi-platform products across Android, iOS, and Web ecosystems[cite: 1]",
      "Increased user engagement by 150% and reduced drop-off rates by 30% via iterative prototyping[cite: 1]",
      "Engineered design systems and comprehensive style guides, cutting developer onboarding time by 40%[cite: 1]"
    ]
  },
  {
    role: "Sr. Executive, Design & Media Planning",
    company: "Piickme Ltd.",
    period: "2019 — 2019",
    current: false,
    description: "Designed core user onboarding journeys and multi-channel campaign creative assets aligning business growth with usability[cite: 1].",
    highlights: [
      "Built interactive prototypes and visual wireframes enhancing ride-sharing app workflows[cite: 1]",
      "Directed end-to-end campaign visual guidelines and product onboarding videos[cite: 1]"
    ]
  },
  {
    role: "Sr. Designer & IT Specialist",
    company: "Lamudi Bangladesh",
    period: "2017 — 2019",
    current: false,
    description: "Managed complete digital presence and UI maintenance while orchestrating IT systems infrastructure[cite: 1].",
    highlights: [
      "Collaborated with global design teams to optimize marketplace user conversion flows[cite: 1]",
      "Drove 25% growth in digital lead volumes through conversion-optimized layouts[cite: 1]"
    ]
  }
];

const skillCategories = [
  {
    category: "Product & Strategy",
    items: ["UI/UX Design", "B2B Business Development", "Design Systems", "Prototyping", "User Research", "Wireframing"]
  },
  {
    category: "Tools & Frameworks",
    items: ["Figma", "Adobe Illustrator", "Photoshop", "After Effects", "Jira", "Astro & Tailwind"]
  },
  {
    category: "Execution & Leadership",
    items: ["Stakeholder Alignment", "Enterprise Sales", "Media Planning", "Cross-functional Leadership"]
  }
];
---

<Layout title="Muhammad Shaher Al Rahman — Portfolio">
  <!-- Navigation Header -->
  <header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-zinc-950/70 border-b border-zinc-800/60">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="font-bold tracking-tight text-lg group flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400 group-hover:scale-125 transition-transform duration-300"></span>
        <span class="group-hover:text-amber-400 transition-colors">Shaher.</span>
      </a>
      
      <nav class="hidden md:flex items-center gap-8 text-sm text-zinc-400">
        {navItems.map(item => (
          <a href={item.href} class="hover:text-zinc-100 transition-colors duration-200">
            {item.label}
          </a>
        ))}
      </nav>

      <a 
        href="#contact" 
        class="inline-flex items-center justify-center px-4 py-1.5 text-xs font-medium rounded-full bg-zinc-900 border border-zinc-700 text-zinc-200 hover:bg-zinc-800 hover:border-zinc-600 transition-all duration-200"
      >
        Get in touch
      </a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 pt-32 pb-24 space-y-32">
    <!-- Hero Section -->
    <section class="reveal space-y-6 pt-10 md:pt-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-medium">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
        </span>
        Deputy Manager, Business Development & Product Designer
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-zinc-100 leading-tight">
        Building high-impact <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-400">digital experiences</span> & strategic growth.
      </h1>

      <p class="text-lg sm:text-xl text-zinc-400 max-w-2xl leading-relaxed font-light">
        I am Muhammad Shaher Al Rahman (Nabil) — merging product design architecture with enterprise business development to scale digital systems from early design to market expansion[cite: 1].
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a 
          href="#experience" 
          class="px-6 py-3 rounded-xl bg-zinc-100 text-zinc-950 font-semibold text-sm hover:bg-amber-400 hover:shadow-lg hover:shadow-amber-400/20 transition-all duration-300 transform active:scale-95"
        >
          Explore Work
        </a>
        <a 
          href="https://www.linkedin.com/in/shaher404/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-6 py-3 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 font-medium text-sm hover:border-zinc-700 hover:text-zinc-100 transition-all duration-200"
        >
          LinkedIn Profile[cite: 1]
        </a>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start border-t border-zinc-800/80 pt-16">
      <div class="md:col-span-4">
        <h2 class="text-xs uppercase tracking-widest text-amber-400/90 font-semibold mb-2">Background</h2>
        <p class="text-2xl font-bold tracking-tight text-zinc-100">The intersection of design craft & business value.</p>
      </div>
      <div class="md:col-span-8 space-y-4 text-zinc-400 leading-relaxed font-light">
        <p>
          With a design track record dating back to 2017, I spent years running end-to-end product lifecycles — moving from UX wireframing and design token architecture to complex mobile application launches as a self-directed, full-cycle designer[cite: 1].
        </p>
        <p>
          At Z3 Corporation, I translate product comprehension directly into corporate value. By combining functional understanding of user interaction and business development strategy, I close the loop between high-level executive negotiations and user-centered platform execution.
        </p>
      </div>
    </section>

    <!-- Experience Timeline -->
    <section id="experience" class="space-y-12 border-t border-zinc-800/80 pt-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 class="text-xs uppercase tracking-widest text-amber-400/90 font-semibold mb-2">Career</h2>
          <p class="text-3xl font-bold tracking-tight text-zinc-100">Work Experience</p>
        </div>
        <p class="text-xs text-zinc-500">2017 — Present[cite: 1]</p>
      </div>

      <div class="space-y-8">
        {experiences.map((exp) => (
          <div class="relative group p-6 sm:p-8 rounded-2xl border border-zinc-800/70 bg-zinc-900/30 hover:bg-zinc-900/60 hover:border-zinc-700 transition-all duration-300">
            <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 mb-4">
              <div>
                <div class="flex items-center gap-3">
                  <h3 class="text-xl font-bold text-zinc-100 group-hover:text-amber-400 transition-colors">
                    {exp.role}
                  </h3>
                  {exp.current && (
                    <span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider rounded-md bg-amber-400/10 text-amber-300 border border-amber-400/20">
                      Latest
                    </span>
                  )}
                </div>
                <p class="text-sm font-medium text-zinc-400">{exp.company}</p>
              </div>
              <span class="text-xs font-mono text-zinc-500">{exp.period}</span>
            </div>

            <p class="text-sm text-zinc-300 mb-6 leading-relaxed">
              {exp.description}
            </p>

            <ul class="space-y-2">
              {exp.highlights.map((item) => (
                <li class="flex items-start text-xs sm:text-sm text-zinc-400">
                  <span class="text-amber-400 mr-2.5 font-bold">›</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="space-y-12 border-t border-zinc-800/80 pt-16">
      <div>
        <h2 class="text-xs uppercase tracking-widest text-amber-400/90 font-semibold mb-2">Capabilities</h2>
        <p class="text-3xl font-bold tracking-tight text-zinc-100">Skills & Toolstack</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {skillCategories.map((cat) => (
          <div class="p-6 rounded-2xl border border-zinc-800/70 bg-zinc-900/20 space-y-4">
            <h3 class="text-sm font-bold uppercase tracking-wider text-zinc-200">{cat.category}</h3>
            <div class="flex flex-wrap gap-2">
              {cat.items.map((skill) => (
                <span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-800/60 border border-zinc-700/60 text-zinc-300 hover:border-amber-400/40 hover:text-amber-300 transition-colors">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact CTA -->
    <section id="contact" class="rounded-3xl border border-zinc-800 bg-gradient-to-b from-zinc-900/80 to-zinc-950 p-8 sm:p-14 text-center space-y-6 relative overflow-hidden">
      <div class="max-w-xl mx-auto space-y-3">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-100 tracking-tight">Let's discuss new ventures.</h2>
        <p class="text-sm sm:text-base text-zinc-400 leading-relaxed font-light">
          Whether you require high-ticket enterprise business development or bespoke UX architecture, my inbox is open.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a 
          href="mailto:shaheralrahman@gmail.com" 
          class="px-6 py-3 rounded-xl bg-amber-400 text-zinc-950 font-semibold text-sm hover:bg-amber-300 hover:shadow-lg hover:shadow-amber-400/20 transition-all duration-300 transform active:scale-95"
        >
          shaheralrahman@gmail.com[cite: 1]
        </a>
        <a 
          href="https://wa.me/+8801705730197" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-6 py-3 rounded-xl bg-zinc-900 border border-zinc-700 text-zinc-300 font-medium text-sm hover:bg-zinc-800 hover:text-zinc-100 transition-all duration-200"
        >
          WhatsApp[cite: 1]
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-zinc-900 py-8 text-center text-xs text-zinc-600">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p>© {new Date().getFullYear()} Muhammad Shaher Al Rahman. All rights reserved[cite: 1].</p>
      <div class="flex gap-6">
        <a href="https://www.linkedin.com/in/shaher404/" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-400 transition-colors">LinkedIn[cite: 1]</a>
        <a href="https://wa.me/+8801705730197" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-400 transition-colors">WhatsApp[cite: 1]</a>
      </div>
    </div>
  </footer>
</Layout>